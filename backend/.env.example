# ════════════════════════════════════════════════════════
#  Copy this file to .env — NEVER commit .env to git
# ════════════════════════════════════════════════════════

# ── Supabase PostgreSQL ───────────────────────────────────────────────────────
# Project Settings → Database → Connection string → URI (Transaction pooler)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# Upstash Console → Database → Details → Redis URL (use rediss:// for TLS)
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379

# ── Discord Webhook ───────────────────────────────────────────────────────────
# Discord Server → Settings → Integrations → Webhooks → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Set to "true" when GitHub Actions handles alerts (recommended on Render free)
# Set to "false" when running locally or on a paid always-on host
DISABLE_SCHEDULER=true
SIGNAL_REFRESH_INTERVAL=30


TWELVEDATA_API_KEY=your_key_here